{{- /* vim: set ft=sh: */ -}}
ZDOTDIR="{{ .zdotdir }}"

ZGEN_DIR="$ZDOTDIR/zgen"
source "$ZGEN_DIR/zgen.zsh"

if ! zgen saved; then
  zgen load denysdovhan/spaceship-prompt spaceship

  zgen load "$ZDOTDIR/completion.zsh"
  zgen load "$ZDOTDIR/key-bindings.zsh"
  zgen load "$ZDOTDIR/prompt.zsh"

  zgen save
fi

HISTFILE="$ZDOTDIR/history"
HISTSIZE=100000
SAVEHIST=100000

# for faster switching between vi modes
KEYTIMEOUT=1

# don't remove space after completion
# https://superuser.com/a/613817
ZLE_REMOVE_SUFFIX_CHARS=$' \t\n;'

setopt auto_cd
setopt complete_in_word
setopt correct
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt share_history
unsetopt beep
unsetopt glob_dots

typeset -U path
path+=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.dotnet/tools" "$HOME/.go/bin")

alias e='$EDITOR'
alias se=sudoedit
alias ls='ls --color=auto'
alias l='ls -Fhl'
alias la='ls -aFhl'
alias ll='ls -AFhl'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

export EDITOR={{ .editor }}
export VISUAL={{ .editor }}
export PAGER=less

{{ if .enable_fzf -}}
if [[ -e {{ .fzfdir }}/completion.zsh ]]; then
  source "{{ .fzfdir }}/completion.zsh"
fi
if [[ -e {{ .fzfdir }}/key-bindings.zsh ]]; then
  source "{{ .fzfdir }}/key-bindings.zsh"
fi
if command -v fd &> /dev/null; then
  export FZF_DEFAULT_COMMAND='fd ""'
elif command -v fdfind &> /dev/null; then
  export FZF_DEFAULT_COMMAND='fdfind ""'
fi
{{- end }}

{{- if .enable_nvm }}

NVM_SOURCE='{{ .nvmsrc }}'
if [[ -e $NVM_SOURCE ]]; then
  export NVM_SOURCE
  export NVM_DIR="{{ .nvmdir }}"
  source "$NVM_SOURCE/nvm.sh" --no-use
  source "$NVM_SOURCE/bash_completion"
fi
{{- end }}

if command -v fastfetch &> /dev/null; then
  fastfetch
fi
